<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080610"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/txtLogo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="FR4NX VIP"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="#B78AFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="v4.2 PRO"
                android:textColor="#00FFCC"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Live Terminal Console -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="SYSTEM LOG"
            android:textColor="#B78AFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"/>

        <TextView
            android:id="@+id/txtConsole"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/terminal_bg"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:text="> Initializing FR4NX Engine...\n> Scanning for Free Fire process..."
            android:textColor="#00FFCC"
            android:textSize="11sp" />

        <!-- Features -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="MEMORY INJECTION"
            android:textColor="#B78AFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <Switch
                android:id="@+id/aimbotSwitch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Auto-Headshot (Aimbot)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:buttonTint="#B78AFF" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A1F3D" />

            <Switch
                android:id="@+id/espSwitch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Wallhack (ESP)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:buttonTint="#B78AFF" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#2A1F3D" />

            <Switch
                android:id="@+id/recoilSwitch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="No Recoil"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:buttonTint="#B78AFF" />
        </LinearLayout>

        <!-- Permissions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="BYPASS REQUIREMENTS"
            android:textColor="#B78AFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"/>

        <Button
            android:id="@+id/overlayPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:text="1. Mount Mod Overlay"
            android:textAllCaps="false"
            android:textColor="#D8B4FE" />

        <Button
            android:id="@+id/accessibilityPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:text="2. Enable Auto-Injector"
            android:textAllCaps="false"
            android:textColor="#D8B4FE" />

        <!-- Activate -->
        <Button
            android:id="@+id/activateButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/btn_glow"
            android:text="ACTIVATE HACK"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="15dp"
            android:progressTint="#00FFCC"
            android:progressBackgroundTint="#1A1525"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="READY TO INJECT"
            android:textColor="#8875AA"
            android:textSize="11sp"
            android:letterSpacing="0.1"/>

    </LinearLayout>
</ScrollView>
