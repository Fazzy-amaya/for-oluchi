<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5080610"
    android:clickable="true"
    android:focusable="true">

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:background="#228B5CF6"
        android:alpha="0.35"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FR4NX"
            android:textColor="#B794FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.35"/>

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="55dp"
            android:background="@drawable/purple_glass"
            android:elevation="12dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◈"
                android:textColor="#A879FF"
                android:textSize="82sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="DEVICE LOCKED"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <!-- COUNTDOWN TIMER -->
        <TextView
            android:id="@+id/countdownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="23:59:59"
            android:textColor="#FF5555"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="This device is currently in a restricted session."
            android:textColor="#AAA3B8"
            android:textSize="13sp"/>

        <!-- STATUS TEXT FOR WIPING/DECRYPTING -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text=""
            android:textColor="#FF0000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- PROGRESS BAR FOR FAKE ACTIONS -->
        <ProgressBar
            android:id="@+id/actionProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:progressTint="#FF0000"
            android:progressBackgroundTint="#30243E"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/authInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="38dp"
            android:paddingHorizontal="18dp"
            android:hint="Enter authentication key"
            android:textColor="#FFFFFF"
            android:textColorHint="#786987"
            android:background="@drawable/input_glass"
            android:inputType="textPassword"
            android:singleLine="true"
            android:visibility="gone"/>

        <Button
            android:id="@+id/authButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="VERIFY IDENTITY"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#9333EA"
            android:visibility="gone"/>

    </LinearLayout>
</FrameLayout>
